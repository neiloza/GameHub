# --- Supabase (required) ---------------------------------------------------
# Local dev: `supabase start` prints both of these.
# Production: create a project, then copy Project Settings → API → Project URL
# and the "anon"/public key.
#
# These are inlined at BUILD time, not read at runtime, so they have to be set
# in your host's build environment (e.g. Cloudflare Pages → Settings →
# Environment variables) and a rebuild is needed after changing one.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key

# --- Social sign-in --------------------------------------------------------
# Set to "true" ONLY after enabling the Google and Apple providers in the
# Supabase dashboard (Authentication → Providers) and adding this origin to the
# redirect allowlist. Otherwise the buttons call providers that are switched
# off and simply error, which looks to the member like a broken account.
# Leave unset for email and password only.
# NEXT_PUBLIC_ENABLE_SOCIAL_AUTH=true
