{
  "name": "@marketplace/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/write-version.mjs && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "pages:build": "node scripts/write-version.mjs && next-on-pages",
    "pages:preview": "wrangler pages dev .vercel/output/static --compatibility-flags nodejs_compat"
  },
  "dependencies": {
    "@marketplace/shared": "workspace:*",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.48.1",
    "next": "^15.1.6",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.5",
    "@tailwindcss/postcss": "^4.0.6",
    "@types/node": "^22.13.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "tailwindcss": "^4.0.6",
    "typescript": "^5.7.3",
    "wrangler": "^3.99.0"
  }
}
