# Edge function secrets. Copy to .env, fill in what you need, then:
#   supabase secrets set --env-file supabase/functions/.env
#
# Nothing here is required to run the platform. Without these, checkout and
# identity verification degrade with a clear "not configured" error and the
# notification center works without email or push.

# Where members are sent back to after a hosted checkout or verification flow.
SITE_URL=http://localhost:3000

# --- payments (billing-checkout, billing-portal, billing-webhook) ------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# One price id per plan. Only the plans you intend to sell need a value.
STRIPE_PRICE_INTRO_MONTHLY=
STRIPE_PRICE_INTRO_ANNUAL=
STRIPE_PRICE_STANDARD_MONTHLY=
STRIPE_PRICE_STANDARD_ANNUAL=

# --- identity (identity-verify, identity-webhook) ---------------------------
# A separate webhook secret from the billing one: they are separate endpoints
# in the dashboard and sharing a secret means one leak compromises both.
STRIPE_IDENTITY_WEBHOOK_SECRET=

# --- email (notification-dispatch) ------------------------------------------
# Anything that accepts a JSON POST of {profile_id, kind, payload} and turns it
# into mail — your own worker, a CRM, an automation platform. Left empty, the
# dispatcher marks email deliveries done without sending anything.
EMAIL_WEBHOOK_URL=
